{
  "name": "imacomputerussy",
  "version": "2.1.0",
  "description": "iMaCoMpUtERussy - Interactive 8-bit CPU emulator with terminal I/O, video graphics, real-time debugging, and steganography capabilities. Created by Kyle Durepos.",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node tests/run-tests.js",
    "test:cpu": "node tests/cpu*.test.js",
    "test:memory": "node tests/memory*.test.js",
    "test:assembler": "node tests/assembler*.test.js",
    "test:integration": "node tests/integration*.test.js",
    "test:all": "npm test && npm run integration-tests",
    "mcp-server": "node server/mcp_server.js",
    "queue-server": "node server/queue-server.js",
    "autonomous-agent": "node agent/autonomous-agent.js",
    "autonomous-system-start": "concurrently 'npm run mcp-server' 'npm run queue-server' 'npm run autonomous-agent'",
    "integration-tests": "npm run --prefix integration test",
    "docs": "npm run docs:serve",
    "docs:serve": "mkdir -p docs && python -m http.server 8003 -d docs",
    "setup": "npm install",
    "build": "npm run setup",
    "samples": "echo 'Sample programs available in samples/ directory'"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kyledurepos/imacomputerussy"
  },
  "license": "MIT",
  "author": "Kyle Durepos",
  "keywords": [
    "emulator",
    "cpu",
    "interactive",
    "terminal",
    "assembly",
    "debugging",
    "steganography",
    "video",
    "javascript",
    "retro",
    "education",
    "imacomputerussy"
  ],
  "dependencies": {
    "express": "^4.18.2",
    "ajv": "^8.12.0",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "supertest": "^6.3.3"
  }
}