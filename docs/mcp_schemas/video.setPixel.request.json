{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "x",
    "y",
    "color"
  ],
  "properties": {
    "x": {
      "type": "integer",
      "minimum": 0,
      "maximum": 31
    },
    "y": {
      "type": "integer",
      "minimum": 0,
      "maximum": 31
    },
    "color": {
      "type": "integer",
      "minimum": 0,
      "maximum": 15
    }
  }
}