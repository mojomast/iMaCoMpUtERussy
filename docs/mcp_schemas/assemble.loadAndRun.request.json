{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "source"
  ],
  "properties": {
    "source": {
      "type": "string"
    },
    "resetCPU": {
      "type": "boolean",
      "default": true
    },
    "maxSteps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    }
  }
}