{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "name"
  ],
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the program to load from samples/",
      "pattern": "^[a-zA-Z0-9_\\-]+((\\.asm)?)?$"
    },
    "startAddress": {
      "type": "integer",
      "description": "Optional start address to load program at",
      "default": 1536,
      "minimum": 0,
      "maximum": 65535
    }
  }
}