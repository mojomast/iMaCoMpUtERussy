{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Error Response",
  "type": "object",
  "required": ["success", "error"],
  "properties": {
    "success": { "type": "boolean", "enum": [false] },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "details": { "type": "object" }
      }
    }
  }
}