{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "success": {
      "type": "boolean"
    },
    "data": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "bytesWritten": {
          "type": "integer"
        },
        "savedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}