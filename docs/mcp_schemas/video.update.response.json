{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["success", "data"],
  "properties": {
    "success": {
      "type": "boolean",
      "enum": [true]
    },
    "data": {
      "type": "object",
      "required": ["durationMs"],
      "properties": {
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "type": "string"
        }
      }
    }
  }
}