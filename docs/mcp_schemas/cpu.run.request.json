{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["maxSteps"],
  "properties": {
    "maxSteps": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "stepDelay": { "type": "integer", "minimum": 0, "maximum": 100, "default": 1 },
    "breakOnHalt": { "type": "boolean", "default": true }
  }
}