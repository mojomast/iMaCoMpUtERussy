# iMaCoMpUtERussy AI Configuration
# Copy this file to .env and fill in your actual API keys

# OpenAI Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic Configuration  
# Get your API key from: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# OpenRouter Configuration
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# Requesty.ai Configuration (Unified LLM Gateway)
# Get your API key from: https://requesty.ai
# Provides intelligent routing, cost optimization, and unified access to all models
REQUESTY_API_KEY=rq_your-requesty-api-key-here
REQUESTY_PROJECT_ID=your-project-id

# Meta/Code Llama Configuration (optional)
# Currently not supported but can be added in future
META_API_KEY=your-meta-api-key-here

# Server Configuration
MCP_PORT=3000
MCP_HOST=127.0.0.1

# Rate Limiting Configuration (requests per minute)
AI_RATE_LIMIT=60

# Default Model Selection
# Direct provider models:
#   OpenAI: gpt-4, gpt-4-turbo-preview, gpt-3.5-turbo, gpt-3.5-turbo-16k
#   Anthropic: claude-3-opus, claude-3-sonnet, claude-3-haiku, claude-2.1, claude-instant
# Via gateways (prefix with provider/):
#   OpenRouter: openrouter/auto, openrouter/openai/gpt-4-turbo, openrouter/anthropic/claude-3-opus
#   Requesty: requesty/auto, requesty/gpt-4, requesty/claude-3-opus, requesty/xai/grok-code-fast-1
DEFAULT_MODEL=requesty/auto

# OpenRouter Model Selection (if using OpenRouter)
# See available models at: https://openrouter.ai/models
OPENROUTER_MODEL=openai/gpt-4-turbo-preview

# Requesty Model Selection (if using Requesty)
# Specific models: gpt-4, gpt-4-turbo, gpt-3.5-turbo, claude-3-opus, claude-3-sonnet, 
#                  claude-3-haiku, xai/grok-code-fast-1, xai/grok-beta, xai/grok-2-1212,
#                  gemini-pro, mixtral-8x7b, llama-2-70b
# Or use 'auto' for intelligent routing
REQUESTY_MODEL=auto
# Routing modes: cost-optimized, quality-optimized, balanced, speed-optimized
REQUESTY_ROUTING_MODE=balanced

# API Endpoints (usually don't need to change these)
OPENAI_ENDPOINT=https://api.openai.com/v1/chat/completions
ANTHROPIC_ENDPOINT=https://api.anthropic.com/v1/messages
OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
REQUESTY_ENDPOINT=https://api.requesty.ai/v1/chat/completions

# Enable debug logging for AI requests
AI_DEBUG=false
